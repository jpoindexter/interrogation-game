# Required — Mistral API (case generation, interrogation, evaluation, STT)
MISTRAL_API_KEY=

# Required — ElevenLabs TTS for suspect voice
ELEVENLABS_API_KEY=

# Optional — specific ElevenLabs voice ID
ELEVENLABS_VOICE_ID=

# Required — Supabase (leaderboard, patterns, game exports)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional — admin-only, for /api/export endpoint
SUPABASE_SERVICE_ROLE_KEY=
EXPORT_SECRET=
