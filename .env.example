# Local demo: existing Codex ChatGPT sign-in; no API key required.
AI_PROVIDER=codex-local
CODEX_MODEL=gpt-6.1-sol
# Lower-usage option: gpt-6-luna. Existing local overrides remain in effect.
# Draft cases with the faster model; independent review and dialogue use CODEX_MODEL.
CODEX_CASE_MODEL=gpt-6-luna
# Optional override; defaults to the pinned project node_modules/.bin/codex.
# CODEX_BIN=/absolute/path/to/codex
AI_TIMEOUT_MS=90000
# Overall draft + independent review deadline; each provider call retains AI_TIMEOUT_MS.
AI_GENERATION_TIMEOUT_MS=120000
# Operator stop switch; false prevents new structured AI and embedding work after server restart.
AI_WORK_ENABLED=true

# OpenAI adapter for explicit shared text mode; separately billed API credentials.
# AI_PROVIDER=openai
OPENAI_MODEL=gpt-6-luna
OPENAI_API_KEY=

# Optional ElevenLabs voice. Shared mode additionally requires the opt-in below.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# Default: durable local demo state with the Codex adapter above.
SESSION_STORAGE=local
LEADERBOARD_STORAGE=local
EXPORT_STORAGE=local
INTERROGATION_DATA_DIR=.local

# Shared text opt-in. Apply migrations 001, 004, then 006 through 017 in order.
# See database/README.md and docs/audit/HOSTED-ROUTE-INTEGRATION.md.
# To select it, set SESSION_STORAGE, LEADERBOARD_STORAGE and EXPORT_STORAGE to supabase,
# AI_PROVIDER=openai, HOSTED_TEXT_ENABLED=true, and configure the server credentials.
# Local storage is refused when VERCEL is set; there is no local fallback on failure.
HOSTED_TEXT_ENABLED=false
# Stable allowance namespace; do not rotate it to reset usage.
# HOSTED_DEPLOYMENT_ID=portfolio-preview
# Required operator-selected integer caps before the first provider reservation.
# Calls: 0..1000000; input characters: 0..1000000000000; window: 60..86400 seconds.
# Blank caps are deliberately not a usable hosted configuration. Zero admits no AI work.
# HOSTED_AI_CALLS_PER_WINDOW=
# HOSTED_AI_CHARACTERS_PER_WINDOW=
# HOSTED_AI_WINDOW_SECONDS=3600
# Caps/window are frozen for an existing deployment/provider policy after the first reservation attempt.
# Canonical exports persist atomically; private downloads use byte-bounded pages.

# Optional hosted voice: defaults off and never falls back to local receipts.
HOSTED_VOICE_ENABLED=false
# Create a PRIVATE Supabase bucket as an authorized operator; the app never creates one.
# HOSTED_VOICE_BUCKET=interrogation-voice
# Required explicit caps; voice uses HOSTED_AI_WINDOW_SECONDS for its database window.
# HOSTED_TTS_CALLS_PER_WINDOW=
# HOSTED_TTS_CHARACTERS_PER_WINDOW=
# HOSTED_STT_CALLS_PER_WINDOW=
# HOSTED_STT_BYTES_PER_WINDOW=
# Hosted recordings: 3 MiB. Audio downloads: private, signed for 60 seconds.
# Configuration is not evidence of live storage, provider or browser acceptance.

# Optional remote leaderboard / historical retrieval / admin export.
# Optional managed project origin only: https://your-project.supabase.co
# Custom domains, self-hosted endpoints, private IPs and redirects are not supported.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
EXPORT_SECRET=

# OFF for shared text mode and the portfolio demo. Local experimentation additionally
# requires 005_event_grounded_patterns.sql (see database/README.md).
# Requires OPENAI_API_KEY + Supabase; Codex subscriptions do not supply embeddings.
# Retrieval uses questions linked to accepted evidence events,
# not proven effective tactics or model training. Keep disabled until evaluated.
AI_RAG_ENABLED=false
RAG_EMBEDDING_VERSION=openai-text-embedding-3-small-1536-events-v2
